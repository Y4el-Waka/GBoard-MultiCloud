# CoreView Cloud Lab - local development
APP_SECRET_KEY=change-me-local-only
PORT=5067
DB_PATH=usuarios.db
OUTPUT_PATH=estado_sensores_prtg.json
PRTG_SERVERS_FILE=servers.json
PRTG_VERIFY_SSL=0
UPDATE_INTERVAL=30
REQUEST_TIMEOUT=10
MAX_WORKERS=6
METRICS_WINDOW_MINUTES=120
DEVICE_CACHE_TTL_SECONDS=600
MF_SLA_HOURS=6
SENSOR_EVENT_RETENTION_DAYS=90
SESSION_HOURS=8
SESSION_COOKIE_SECURE=0
SEED_DEFAULT_USERS=0
# Example only. Prefer: flask --app app create-user <user> <password>
DEFAULT_USERS_JSON=[]
# Opt-in values: synthetic (local laboratory) or prtg (authorized read-only PRTG).
COREVIEW_METRICS_PROVIDER=disabled
COREVIEW_METRICS_UI_ENABLED=false

# Required only when COREVIEW_METRICS_PROVIDER=prtg.
# Use the IANA timezone configured by the selected PRTG installation.
COREVIEW_PRTG_SOURCE_TIMEZONE=UTC
COREVIEW_PRTG_HISTORY_AVERAGE_SECONDS=300
COREVIEW_PRTG_HISTORY_MAX_REQUESTS_PER_MINUTE=5
COREVIEW_PRTG_DISCOVERY_CACHE_TTL_SECONDS=300
COREVIEW_PRTG_DISCOVERY_CACHE_MAX_ENTRIES=128
# The experimental in-memory request budget is process-local.
COREVIEW_PRTG_METRICS_EXPECTED_PROCESSES=1

#!/usr/bin/env bash
set -euo pipefail

readonly install_root="/opt/coreview"
readonly compose_plugin="/usr/local/lib/docker/cli-plugins/docker-compose"
readonly runtime_disk="/dev/oracleoci/oraclevdb"
readonly docker_root="/var/lib/docker"
readonly registry_host='${registry_host}'
readonly bootstrap_marker="$install_root/.bootstrap-${bootstrap_revision}-complete"

if [[ -f "$bootstrap_marker" ]]; then
  echo "CoreView host bootstrap revision ${bootstrap_revision} already completed."
  exit 0
fi

# Prevent RPM scriptlets from starting Docker before the persistent volume is
# mounted at /var/lib/docker.
systemctl mask docker.service docker.socket
install -d -m 0755 /etc/yum.repos.d
curl --fail --silent --show-error --location --max-redirs 3 --proto '=https' --tlsv1.2 \
  https://download.docker.com/linux/centos/docker-ce.repo \
  --output /etc/yum.repos.d/docker-ce.repo
printf '%s  %s\n' '${docker_repo_file_sha256}' /etc/yum.repos.d/docker-ce.repo \
  | sha256sum --check --status

dnf install --assumeyes --setopt=install_weak_deps=False \
  ${base_package_nevras} \
  "docker-ce-${docker_ce_version}" \
  "docker-ce-cli-${docker_ce_cli_version}" \
  "containerd.io-${containerd_version}" \
  "golang-${go_package_version}"

for attempt in $(seq 1 90); do
  if [[ -b "$runtime_disk" ]]; then
    break
  fi
  if [[ "$attempt" -eq 90 ]]; then
    echo "Runtime volume did not appear; refusing to continue bootstrap." >&2
    exit 1
  fi
  sleep 1
done

if ! blkid -p "$runtime_disk" >/dev/null 2>&1; then
  if wipefs --noheadings "$runtime_disk" | grep -q "[^[:space:]]"; then
    echo "Runtime volume contains an unknown signature; refusing to format it." >&2
    exit 1
  fi
  mkfs.ext4 -F -L coreview-runtime "$runtime_disk"
fi

runtime_fstype="$(blkid -s TYPE -o value "$runtime_disk")"
if [[ "$runtime_fstype" != "ext4" ]]; then
  echo "Runtime volume filesystem is not ext4; refusing to mount it." >&2
  exit 1
fi

install -d -m 0711 "$docker_root"
runtime_uuid="$(blkid -s UUID -o value "$runtime_disk")"
if [[ -z "$runtime_uuid" ]]; then
  echo "Runtime volume has no filesystem UUID; refusing to continue." >&2
  exit 1
fi
if ! grep -Fq "UUID=$runtime_uuid " /etc/fstab; then
  printf 'UUID=%s %s ext4 defaults,nodev,nosuid 0 2\n' \
    "$runtime_uuid" "$docker_root" >> /etc/fstab
fi
if ! mountpoint --quiet "$docker_root"; then
  mount "$docker_root"
fi

install -d -m 0755 /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/coreview-runtime.conf <<'DOCKER_MOUNT_UNIT'
[Unit]
RequiresMountsFor=/var/lib/docker
After=var-lib-docker.mount
DOCKER_MOUNT_UNIT

install -d -m 0755 "$(dirname "$compose_plugin")" "$install_root/bin"
curl --fail --silent --show-error --location --max-redirs 3 --proto '=https' --tlsv1.2 \
  "https://github.com/docker/compose/releases/download/v${docker_compose_version}/docker-compose-linux-x86_64" \
  --output "$compose_plugin"
printf '%s  %s\n' '${docker_compose_sha256}' "$compose_plugin" \
  | sha256sum --check --status
chmod 0755 "$compose_plugin"

# Oracle's OCIR Instance Principal pattern requires a Docker credential helper.
# Build only the reviewed source revision and verify both archive and binary.
helper_build_dir="$(mktemp -d /var/tmp/coreview-ocir-helper.XXXXXX)"
cleanup_helper() {
  rm -rf -- "$helper_build_dir"
}
trap cleanup_helper EXIT
curl --fail --silent --show-error --location --max-redirs 3 --proto '=https' --tlsv1.2 \
  "https://codeload.github.com/jan-g/ip-credential/tar.gz/${ocir_helper_source_commit}" \
  --output "$helper_build_dir/source.tar.gz"
printf '%s  %s\n' '${ocir_helper_source_sha256}' "$helper_build_dir/source.tar.gz" \
  | sha256sum --check --status
mkdir "$helper_build_dir/source"
tar --extract --gzip --file "$helper_build_dir/source.tar.gz" \
  --directory "$helper_build_dir/source" --strip-components=1
(
  cd "$helper_build_dir/source"
  CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -mod=readonly -trimpath -buildvcs=false \
      -o "$helper_build_dir/docker-credential-ocir" .
)
printf '%s  %s\n' '${ocir_helper_binary_sha256}' "$helper_build_dir/docker-credential-ocir" \
  | sha256sum --check --status
install -d -m 0755 /usr/local/libexec/coreview
install -m 0755 "$helper_build_dir/docker-credential-ocir" \
  /usr/local/libexec/coreview/docker-credential-ocir-upstream
trap - EXIT
cleanup_helper

# The tutorial helper currently accepts arbitrary registry input. Keep the
# verified upstream binary behind a fail-closed wrapper restricted to the one
# OCIR endpoint selected by this Terraform stack.
cat > /usr/local/bin/docker-credential-coreview-ocir <<'OCIR_HELPER_WRAPPER'
#!/usr/bin/env bash
set -euo pipefail

readonly allowed_registry='${registry_host}'
readonly upstream="/usr/local/libexec/coreview/docker-credential-ocir-upstream"
readonly operation="$${1:-}"

validate_registry() {
  local supplied="$1"
  case "$supplied" in
    "$allowed_registry"|"https://$allowed_registry"|"https://$allowed_registry/") ;;
    *)
      echo "Credential request rejected: registry is outside the approved OCIR endpoint." >&2
      exit 1
      ;;
  esac
}

case "$operation" in
  get)
    IFS= read -r registry_url
    validate_registry "$registry_url"
    printf '%s\n' "$registry_url" | exec "$upstream" get
    ;;
  erase)
    IFS= read -r registry_url
    validate_registry "$registry_url"
    ;;
  store)
    echo "Static Docker credential storage is disabled; use Instance Principal." >&2
    exit 1
    ;;
  list)
    printf '{}\n'
    ;;
  *)
    echo "Unsupported Docker credential-helper operation." >&2
    exit 1
    ;;
esac
OCIR_HELPER_WRAPPER
chmod 0755 /usr/local/bin/docker-credential-coreview-ocir

dnf remove --assumeyes "golang-${go_package_version}"


dnf clean all

install -d -m 0700 /root/.docker
python3 - "$registry_host" <<'PY'
import json
import pathlib
import sys

target = pathlib.Path("/root/.docker/config.json")
target.write_text(json.dumps({"credHelpers": {sys.argv[1]: "coreview-ocir"}}, sort_keys=True) + "\n")
target.chmod(0o600)
PY

printf '%s' '${compose_config_b64}' | base64 --decode > "$install_root/compose.yaml"
printf '%s' '${servers_config_b64}' | base64 --decode > "$install_root/servers.synthetic.json"
chown root:root "$install_root/compose.yaml" "$install_root/servers.synthetic.json"
chmod 0644 "$install_root/compose.yaml" "$install_root/servers.synthetic.json"

cat > "$install_root/bin/pull-and-start" <<'PULL_AND_START'
#!/usr/bin/env bash
set -euo pipefail

readonly image_repository='${image_repository}'
readonly env_file="/opt/coreview/.env"

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a
readonly expected_image_prefix="$image_repository@sha256:"
if [[ "$${COREVIEW_IMAGE:-}" != "$expected_image_prefix"* ]]; then
  echo "COREVIEW_IMAGE must reference the expected OCIR repository by digest." >&2
  exit 1
fi
image_digest="$${COREVIEW_IMAGE#"$expected_image_prefix"}"
if [[ ! "$image_digest" =~ ^[0-9a-f]{64}$ ]]; then
  echo "COREVIEW_IMAGE contains an invalid sha256 digest." >&2
  exit 1
fi
readonly image_uri="$COREVIEW_IMAGE"
unset COREVIEW_IMAGE image_digest

# Each docker pull process invokes the restricted helper, which obtains a fresh
# ephemeral token through Instance Principal. Retry boundedly because new IAM
# dynamic-group/policy grants are propagated asynchronously by OCI.
pull_succeeded=false
for attempt in $(seq 1 60); do
  if docker pull "$image_uri"; then
    pull_succeeded=true
    break
  fi
  if [[ "$attempt" -lt 60 ]]; then
    sleep 10
  fi
done
if [[ "$pull_succeeded" != true ]]; then
  echo "Image pull failed after bounded IAM/registry retries; CoreView remains stopped." >&2
  exit 1
fi
docker compose --env-file /opt/coreview/.env --file /opt/coreview/compose.yaml \
  up --detach --wait --wait-timeout 180 --pull never
PULL_AND_START
chmod 0755 "$install_root/bin/pull-and-start"

cat > "$install_root/bin/initialize-lab-secrets" <<'INITIALIZE_SECRETS'
#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ "$EUID" -ne 0 ]]; then
  exec sudo -- "$0" "$@"
fi
if [[ "$#" -ne 1 || ! "$1" =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "Usage: $0 sha256:<approved-64-hex-manifest-digest>" >&2
  exit 1
fi
readonly image_digest="$1"
readonly image_repository='${image_repository}'
readonly image_uri="$image_repository@$image_digest"
readonly env_file="/opt/coreview/.env"
if [[ -e "$env_file" ]]; then
  echo "Refusing to overwrite existing runtime secrets: $env_file" >&2
  exit 1
fi

read -r -s -p "Synthetic lab admin password (16+ characters; letters, digits, dot, underscore or hyphen): " admin_password
printf '\n'
if (( $${#admin_password} < 16 )); then
  echo "Password is shorter than 16 characters; no file was written." >&2
  unset admin_password
  exit 1
fi
if [[ ! "$admin_password" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Password contains an unsafe character; no file was written." >&2
  unset admin_password
  exit 1
fi

app_secret="$(openssl rand -hex 32)"
{
  printf 'COREVIEW_IMAGE=%s\n' "$image_uri"
  printf 'COREVIEW_LAB_APP_SECRET=%s\n' "$app_secret"
  printf 'COREVIEW_LAB_ADMIN_PASSWORD=%s\n' "$admin_password"
} > "$${env_file}.tmp"
chown root:root "$${env_file}.tmp"
chmod 0600 "$${env_file}.tmp"
mv "$${env_file}.tmp" "$env_file"
unset app_secret admin_password

systemctl start coreview-lab.service
echo "Runtime secrets created and CoreView startup requested."
INITIALIZE_SECRETS
chmod 0755 "$install_root/bin/initialize-lab-secrets"

cat > "$install_root/bin/update-runtime-image" <<'UPDATE_IMAGE'
#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ "$EUID" -ne 0 ]]; then
  exec sudo -- "$0" "$@"
fi
if [[ "$#" -ne 1 || ! "$1" =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "Usage: $0 sha256:<approved-64-hex-manifest-digest>" >&2
  exit 1
fi
readonly image_repository='${image_repository}'
readonly image_uri="$image_repository@$1"
readonly env_file="/opt/coreview/.env"
if [[ ! -f "$env_file" ]]; then
  echo "Runtime is not initialized; use initialize-lab-secrets first." >&2
  exit 1
fi
backup="$(mktemp /run/coreview-env-backup.XXXXXX)"
cleanup_update() {
  rm -f -- "$backup" "$env_file.tmp"
}
trap cleanup_update EXIT
cp --preserve=mode,ownership -- "$env_file" "$backup"
awk -v replacement="COREVIEW_IMAGE=$image_uri" '
  BEGIN { updated = 0 }
  /^COREVIEW_IMAGE=/ { print replacement; updated = 1; next }
  { print }
  END { if (!updated) exit 2 }
' "$env_file" > "$env_file.tmp"
chown root:root "$env_file.tmp"
chmod 0600 "$env_file.tmp"
mv "$env_file.tmp" "$env_file"

if systemctl restart coreview-lab.service; then
  echo "CoreView now uses the approved digest."
  exit 0
fi
cp --preserve=mode,ownership -- "$backup" "$env_file"
systemctl start coreview-lab.service || true
echo "Image update failed; the previous runtime configuration was restored." >&2
exit 1
UPDATE_IMAGE
chmod 0755 "$install_root/bin/update-runtime-image"

cat > /etc/systemd/system/coreview-lab.service <<'SYSTEMD_UNIT'
[Unit]
Description=CoreView Cloud Lab synthetic Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/coreview/.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/coreview
ExecStart=/opt/coreview/bin/pull-and-start
ExecStop=/usr/bin/docker compose --env-file /opt/coreview/.env --file /opt/coreview/compose.yaml down --remove-orphans
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
SYSTEMD_UNIT

systemctl unmask docker.service docker.socket
systemctl daemon-reload
systemctl enable --now docker.service
systemctl enable coreview-lab.service
install -m 0600 /dev/null "$bootstrap_marker"

echo "CoreView bootstrap complete; publish a reviewed digest, then initialize secrets through OCI Bastion."
